[Unit]
Description=tdeak67.com AI chat proxy (hides Gemini API key)
After=network.target

[Service]
Type=simple
User=root
# Adjust these paths to match your clone location (e.g. /home/user/tdeak67_website)
WorkingDirectory=REPLACE_WITH_ABSOLUTE_PATH/server
EnvironmentFile=REPLACE_WITH_ABSOLUTE_PATH/.env
ExecStart=REPLACE_WITH_ABSOLUTE_PATH/server/.venv/bin/python REPLACE_WITH_ABSOLUTE_PATH/server/chat_proxy.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target